<% content_for :title, "Password Strength Checker" %>

<div class="container">
  <div class="card">
    <div class="card-header">
      <%= i 'lock' %> Password Strength Checker
    </div>
    <div class="card-body">
      <p class="lead">Type a password below to see how strong it is and learn what makes a good password.</p>

      <div class="mb-4">
        <label for="password-input" class="form-label">Test a password:</label>
        <input type="password" id="password-input" class="form-control form-control-lg font-monospace" placeholder="Type a password..." autocomplete="off" spellcheck="false">
      </div>

      <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <strong>Strength Score</strong>
          <strong id="score-display" class="score-text">0 / 7</strong>
        </div>
        <div class="progress" style="height: 24px;">
          <div id="score-bar" class="progress-bar" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="7"></div>
        </div>
      </div>

      <hr>

      <h5><%= i 'list' %> Password Criteria</h5>
      <p class="text-muted small">Each criterion met earns 1 point. A strong password meets all 7.</p>

      <ul class="list-group list-group-flush" id="criteria-list">
        <li class="list-group-item d-flex align-items-center gap-3" data-criterion="length-8">
          <span class="criterion-icon fs-5"></span>
          <div>
            <strong>At least 8 characters</strong><br>
            <small class="text-muted">Longer passwords are exponentially harder to crack. Each additional character multiplies the difficulty.</small>
          </div>
        </li>
        <li class="list-group-item d-flex align-items-center gap-3" data-criterion="length-12">
          <span class="criterion-icon fs-5"></span>
          <div>
            <strong>At least 12 characters</strong><br>
            <small class="text-muted">12+ characters is the modern standard for secure passwords. This alone makes brute-force attacks impractical.</small>
          </div>
        </li>
        <li class="list-group-item d-flex align-items-center gap-3" data-criterion="lowercase">
          <span class="criterion-icon fs-5"></span>
          <div>
            <strong>Contains lowercase letter</strong><br>
            <small class="text-muted">Adding lowercase letters increases the search space an attacker must try.</small>
          </div>
        </li>
        <li class="list-group-item d-flex align-items-center gap-3" data-criterion="uppercase">
          <span class="criterion-icon fs-5"></span>
          <div>
            <strong>Contains uppercase letter</strong><br>
            <small class="text-muted">Mixing case doubles the letter combinations an attacker has to guess.</small>
          </div>
        </li>
        <li class="list-group-item d-flex align-items-center gap-3" data-criterion="digit">
          <span class="criterion-icon fs-5"></span>
          <div>
            <strong>Contains a digit</strong><br>
            <small class="text-muted">Numbers add 10 more possibilities per position, substantially increasing complexity.</small>
          </div>
        </li>
        <li class="list-group-item d-flex align-items-center gap-3" data-criterion="special">
          <span class="criterion-icon fs-5"></span>
          <div>
            <strong>Contains a special character</strong><br>
            <small class="text-muted">Symbols (!@#$% etc.) add even more possible characters per position, making dictionary attacks far harder.</small>
          </div>
        </li>
        <li class="list-group-item d-flex align-items-center gap-3" data-criterion="no-repeats">
          <span class="criterion-icon fs-5"></span>
          <div>
            <strong>No repeated characters (3+)</strong><br>
            <small class="text-muted">Repeating the same character (e.g. "aaa") creates predictable patterns that cracking tools exploit.</small>
          </div>
        </li>
      </ul>
    </div>
  </div>
</div>

<style>
  .score-text { font-family: "Fira Code", monospace; }
  .criterion-icon { width: 28px; text-align: center; }
</style>

<script>
  (function() {
    const input = document.getElementById('password-input');
    const bar = document.getElementById('score-bar');
    const display = document.getElementById('score-display');

    const checks = {};
    document.querySelectorAll('[data-criterion]').forEach(el => {
      checks[el.dataset.criterion] = el.querySelector('.criterion-icon');
    });

    function meets(pw, test) {
      switch (test) {
        case 'length-8':    return pw.length >= 8;
        case 'length-12':   return pw.length >= 12;
        case 'lowercase':   return /[a-z]/.test(pw);
        case 'uppercase':   return /[A-Z]/.test(pw);
        case 'digit':       return /\d/.test(pw);
        case 'special':     return /[^a-zA-Z0-9]/.test(pw);
        case 'no-repeats':  return !/(.)\1{2,}/.test(pw);
        default:            return false;
      }
    }

    function getStrengthLabel(score) {
      if (score <= 2) return 'Weak';
      if (score <= 4) return 'Fair';
      if (score <= 6) return 'Good';
      return 'Excellent';
    }

    function getBarClass(score) {
      if (score <= 2) return 'bg-danger';
      if (score <= 4) return 'bg-warning';
      if (score <= 6) return 'bg-info';
      return 'bg-success';
    }

    function update() {
      const pw = input.value;
      let score = 0;

      for (const key in checks) {
        const ok = meets(pw, key);
        const icon = checks[key];
        if (ok) {
          score++;
          icon.innerHTML = '<i class="fa-regular fa-circle-check" style="color: #198754;"></i>';
          icon.closest('.list-group-item').classList.add('list-group-item-success');
          icon.closest('.list-group-item').classList.remove('list-group-item-light');
        } else {
          icon.innerHTML = '<i class="fa-regular fa-circle-xmark" style="color: #dc3545;"></i>';
          icon.closest('.list-group-item').classList.remove('list-group-item-success');
          icon.closest('.list-group-item').classList.add('list-group-item-light');
        }
      }

      const label = getStrengthLabel(score);
      const pct = (score / 7) * 100;

      bar.style.width = pct + '%';
      bar.className = 'progress-bar ' + getBarClass(score);
      bar.textContent = label;
      bar.setAttribute('aria-valuenow', score);
      display.textContent = score + ' / 7';
    }

    input.addEventListener('input', update);
  })();
</script>
