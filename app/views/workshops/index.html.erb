<% content_for :title, "Workshops" %>

<div class="container">
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h1 class="mb-0"><%= i 'location-dot' %> Workshops</h1>
      <%= link_to new_workshop_path, class: "btn btn-primary" do %>
        <%= i 'plus' %> New Workshop
      <% end if Current.user.admin? %>
    </div>
    <div class="card-body">
      <% if @workshops.any? %>
        <div class="row">
          <% @workshops.each do |workshop| %>
            <div class="col-12 col-md-4 col-lg-3">
              <div class="card mb-2 text-bg-secondary">
                <div class="card-header">
                  <strong><%= link_to workshop.name, workshop, class: "text-reset text-decoration-none" %></strong>
                </div>
                <div class="card-body">
                  <dl class="mb-0">
                    <dt class="small text-uppercase text-secondary-emphasis"><%= i 'user' %> Instructor</dt>
                    <dd class="mb-0"><%= workshop.instructor.name %></dd>
                  </dl>
                  <p class="small text-muted mt-2 mb-0">
                    <%= i 'calendar' %> <%= time_tag workshop.created_at, "data-bs-toggle": "tooltip", title: workshop.created_at.strftime("%B %d, %Y at %I:%M %p") do %>
                      <%= time_ago_in_words workshop.created_at %> ago
                    <% end %>
                  </p>
                </div>
                <div class="card-footer p-1 d-flex justify-content-end gap-1">
                  <%= link_to edit_workshop_path(workshop), class: "btn btn-sm btn-warning" do %>
                    <%= i 'pencil' %>
                  <% end if Current.user.admin? %>
                  <%= button_to workshop, method: :delete, class: "btn btn-sm btn-danger" do %>
                    <%= i 'trash' %>
                  <% end if Current.user.admin? %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-muted mb-0"><%= i 'ban' %> No workshops yet.</p>
      <% end %>
    </div>
  </div>
</div>
