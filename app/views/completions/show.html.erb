<% content_for :title, @completion.requirement %>

<div class="container">
  <div class="card">
    <div class="card-header">
      <h1 class="mb-0"><%= i 'cube' %> <%= @completion.requirement %></h1>
    </div>
    <div class="card-body">
      <dl class="row mb-0">
        <dt class="col-sm-3"><%= i 'chalkboard-user' %> User</dt>
        <dd class="col-sm-9"><%= @completion.user.name %></dd>
        <dt class="col-sm-3"><%= i 'tag' %> Artifacts</dt>
        <dd class="col-sm-9"><%= @completion.artifacts %></dd>
        <dt class="col-sm-3"><%= i 'tag' %> Complete</dt>
        <dd class="col-sm-9"><%= @completion.complete %></dd>
      </dl>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center">
      <%= link_to completions_path, class: "btn btn-dark" do %>
        <%= i 'arrow-left' %> Back to completions
      <% end %>
      <div class="btn-group">
        <%= link_to edit_completion_path(@completion), class: "btn btn-warning" do %>
          <%= i 'pencil' %> Edit
        <% end if Current.user.admin? %>
        <%= button_to @completion, method: :delete, class: "btn btn-danger" do %>
          <%= i 'trash' %> Delete
        <% end if Current.user.admin? %>
      </div>
    </div>
  </div>
</div>
