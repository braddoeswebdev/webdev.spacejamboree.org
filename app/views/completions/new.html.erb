<% content_for :title, "New completion" %>

<div class="container">
  <div class="card">
    <div class="card-header">
      <h1 class="mb-0"><%= i 'plus' %> New Completion</h1>
    </div>
    <div class="card-body">
      <%= render "form", completion: @completion %>
    </div>
    <div class="card-footer">
      <%= link_to completions_path, class: "btn btn-dark" do %>
        <%= i 'arrow-left' %> Back to completions
      <% end %>
    </div>
  </div>
</div>
