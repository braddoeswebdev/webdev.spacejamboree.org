<% content_for :title, "Editing badge" %>

<div class="container">
  <div class="card">
    <div class="card-header">
      <h1 class="mb-0"><%= i 'pencil' %> Editing Badge</h1>
    </div>
    <div class="card-body">
      <%= render "form", badge: @badge %>
    </div>
    <div class="card-footer">
      <%= link_to @badge, class: "btn btn-dark" do %>
        <%= i 'arrow-left' %> Back to badge
      <% end %>
    </div>
  </div>
</div>
