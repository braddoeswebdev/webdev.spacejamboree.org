<% content_for :title, "New requirement" %>

<div class="container">
  <div class="card">
    <div class="card-header">
      <h1 class="mb-0"><%= i 'plus' %> New Requirement</h1>
    </div>
    <div class="card-body">
      <%= render "form", requirement: @requirement %>
    </div>
    <div class="card-footer">
      <%= link_to requirements_path, class: "btn btn-dark" do %>
        <%= i 'arrow-left' %> Back to requirements
      <% end %>
    </div>
  </div>
</div>
