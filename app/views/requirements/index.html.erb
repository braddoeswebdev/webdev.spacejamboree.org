<% content_for :title, "Requirements" %>

<div class="container">
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h1 class="mb-0"><%= i 'layer-group' %> Requirements</h1>
      <%= link_to new_requirement_path, class: "btn btn-primary" do %>
        <%= i 'plus' %> New Requirement
      <% end if Current.user.admin? %>
    </div>
    <div class="card-body">
      <% if @requirements.any? %>
        <div class="row">
          <% @requirements.each do |requirement| %>
            <div class="col-12 col-md-4 col-lg-3">
              <div class="card mb-2 text-bg-secondary">
                <div class="card-header">
                  <strong><%= image_tag requirement.badge.image, style: 'width: 1em;', title: requirement.badge.name %> <%= link_to requirement.name, requirement, class: "text-reset text-decoration-none" %></strong>
                </div>
                <div class="card-body">
                  <dl class="mb-0">
                    <dt class="small text-uppercase text-secondary-emphasis">Description</dt>
                    <dd class="mb-0"><%= requirement.description %></dd>
                  </dl>
                  <p class="small text-muted mt-2 mb-0">
                    <%= i 'calendar' %> <%= time_tag requirement.created_at, "data-bs-toggle": "tooltip", title: requirement.created_at.strftime("%B %d, %Y at %I:%M %p") do %>
                      <%= time_ago_in_words requirement.created_at %> ago
                    <% end %>
                  </p>
                </div>
                <div class="card-footer p-1 d-flex justify-content-end gap-1">
                  <%= link_to edit_requirement_path(requirement), class: "btn btn-sm btn-warning" do %>
                    <%= i 'pencil' %>
                  <% end if Current.user.admin? %>
                  <%= button_to requirement, method: :delete, class: "btn btn-sm btn-danger" do %>
                    <%= i 'trash' %>
                  <% end if Current.user.admin? %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-muted mb-0"><%= i 'ban' %> No requirements yet.</p>
      <% end %>
    </div>
  </div>
</div>
