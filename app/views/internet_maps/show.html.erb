<% content_for :title, "Internet Map — #{@internet_map.workshop.name}" %>

<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
          <h1 class="mb-0"><%= i 'share-nodes' %> Internet Map — <%= @internet_map.workshop.name %></h1>
          <%= link_to @internet_map.workshop, class: "btn btn-dark btn-sm" do %>
            <%= i 'arrow-left' %> Back to Workshop
          <% end %>
        </div>
        <div class="card-body">
          <p class="text-muted mb-0">
            Each dot is a network hop. Public IPs are shared across scouts; private IPs are per-scout.
            Drag nodes to rearrange. Hover for details.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-9">
      <div data-controller="map" data-map-map-id-value="<%= @internet_map.id %>">
        <div class="card mb-3">
          <div class="card-body p-0" style="position: relative;">
            <div id="cy" style="width: 100%; height: 600px;"></div>
            <div id="node-tooltip" class="card position-absolute shadow-sm"
                 style="display: none; top: 10px; right: 10px; z-index: 1000; max-width: 250px; font-size: 0.85rem; padding: 0.5rem;">
            </div>
          </div>
        </div>

        <div id="map-stream" data-map-target="stream">
          <script type="application/json"><%= @elements.to_json.html_safe %></script>
        </div>
      </div>

      <div class="card mb-3">
        <div class="card-header">
          <h5 class="mb-0"><%= i 'palette' %> Legend</h5>
        </div>
        <div class="card-body" id="legend">
          <div class="d-flex flex-wrap gap-3">
            <% @organizations.each do |org| %>
              <div class="d-flex align-items-center gap-1">
                <span style="display: inline-block; width: 14px; height: 14px; border-radius: 50%; background-color: <%= org.color %>;"></span>
                <small><%= org.name %></small>
              </div>
            <% end %>
            <div class="d-flex align-items-center gap-1">
              <span style="display: inline-block; width: 14px; height: 14px; border-radius: 50%; background-color: #a9a9a9; border: 1px dashed #666;"></span>
              <small>Local Network</small>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-3">
      <div class="card mb-3">
        <div class="card-header">
          <h5 class="mb-0"><%= i 'wifi' %> Submit Traceroute</h5>
        </div>
        <div class="card-body">
          <%= simple_form_for [@internet_map, @traceroute], html: { data: { turbo: false } } do |f| %>
            <%= f.input :target_domain, label: "Target Domain", placeholder: "google.com", wrapper_html: { class: "mb-2" } %>
            <%= f.input :raw_output, as: :text, label: "Paste Traceroute Output", input_html: { rows: 8, style: "font-family: monospace; font-size: 0.8rem;" }, wrapper_html: { class: "mb-2" }, hint: "Run #{tag.kbd 'traceroute google.com'} (Mac/Linux) or #{tag.kbd 'tracert google.com'} (Windows), then paste the full output here.".html_safe %>
            <%= f.submit "Submit", class: "btn btn-success w-100" %>
          <% end %>
        </div>
      </div>

      <div class="card mb-3">
        <div class="card-header">
          <h5 class="mb-0"><%= i 'clock' %> Recent Submissions</h5>
        </div>
        <div class="card-body p-0">
          <ul class="list-group list-group-flush" id="submissions">
            <% @traceroutes.each do |t| %>
              <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                  <strong><%= t.target_domain %></strong>
                  <small class="text-muted d-block"><%= t.user.name %></small>
                  <% if t.failed? && t.error_message.present? %>
                    <small class="text-danger d-block"><%= i 'circle-exclamation' %> <%= t.error_message %></small>
                  <% end %>
                </div>
                <%= traceroute_badge(t) %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>

      <div class="card mb-3">
        <div class="card-body text-center text-muted small">
          IP data via IPLocate.io (CC BY-SA 4.0)
        </div>
      </div>
    </div>
  </div>
</div>
