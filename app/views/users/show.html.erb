<% content_for :title, @user.email_address %>

<div class="container">
  <div class="card">
    <div class="card-header">
      <h1 class="mb-0"><%= i 'user' %> <%= @user.name %></h1>
    </div>
    <div class="card-body">
      <dl class="row mb-0">
        <dt class="col-sm-3"><%= i 'tag' %> Email Address</dt>
        <dd class="col-sm-9"><%= @user.email_address %></dd>
        <dt class="col-sm-3"><%= i 'tag' %> Admin</dt>
        <dd class="col-sm-9"><%= @user.admin %></dd>
      </dl>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center">
      <%= link_to users_path, class: "btn btn-dark" do %>
        <%= i 'arrow-left' %> Back to users
      <% end %>
      <div class="btn-group">
        <%= button_to impersonate_user_path(@user), method: :post, class: "btn btn-info" do %>
          <%= i 'user-secret' %> Impersonate
        <% end if Current.user.admin? && @user != Current.user %>
        <%= link_to edit_user_path(@user), class: "btn btn-warning" do %>
          <%= i 'pencil' %> Edit
        <% end if Current.user.admin? %>
        <%= button_to @user, method: :delete, class: "btn btn-danger" do %>
          <%= i 'trash' %> Delete
        <% end if Current.user.admin? %>
      </div>
    </div>
  </div>
</div>
