<% content_for :title, "Editing user" %>

<div class="container">
  <div class="card">
    <div class="card-header">
      <h1 class="mb-0"><%= i 'pencil' %> Editing User</h1>
    </div>
    <div class="card-body">
      <%= render "form", user: @user %>
    </div>
    <div class="card-footer">
      <%= link_to @user, class: "btn btn-dark" do %>
        <%= i 'arrow-left' %> Back to user
      <% end %>
    </div>
  </div>
</div>
