<% content_for :title, "New user" %>

<div class="container">
  <div class="card">
    <div class="card-header">
      <h1 class="mb-0"><%= i 'plus' %> New User</h1>
    </div>
    <div class="card-body">
      <%= render "form", user: @user %>
    </div>
    <div class="card-footer">
      <%= link_to users_path, class: "btn btn-dark" do %>
        <%= i 'arrow-left' %> Back to users
      <% end %>
    </div>
  </div>
</div>
