<div id="<%%= dom_id <%= singular_name %> %>">
  <div class="card mb-2 text-bg-secondary">
    <div class="card-header">
      <strong><%%= link_to <%= singular_name %>.<%= attributes.first.name %>, <%= singular_name %>, class: "text-reset text-decoration-none" %></strong>
    </div>
    <div class="card-body">
      <dl class="mb-0">
<% attributes.reject(&:password_digest?).reject { |a| a.name == attributes.first.name }.each do |attribute| -%>
        <dt class="small text-uppercase text-secondary-emphasis"><%= attribute.human_name %></dt>
        <dd class="mb-0"><%%= <%= singular_name %>.<%= attribute.name %> %></dd>
<% end -%>
      </dl>
    </div>
  </div>
</div>
