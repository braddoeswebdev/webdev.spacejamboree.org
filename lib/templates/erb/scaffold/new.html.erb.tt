<%% content_for :title, "New <%= human_name.downcase %>" %>

<div class="container">
  <div class="card">
    <div class="card-header">
      <h1 class="mb-0"><%%= i 'plus' %> New <%= human_name %></h1>
    </div>
    <div class="card-body">
      <%%= render "form", <%= singular_table_name %>: @<%= singular_table_name %> %>
    </div>
    <div class="card-footer">
      <%%= link_to <%= index_helper(type: :path) %>, class: "btn btn-dark" do %>
        <%%= i 'arrow-left' %> Back to <%= human_name.pluralize.downcase %>
      <%% end %>
    </div>
  </div>
</div>
