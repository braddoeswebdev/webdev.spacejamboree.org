<%% content_for :title, "<%= human_name.pluralize %>" %>

<div class="container">
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h1 class="mb-0"><%%= i 'layer-group' %> <%= human_name.pluralize %></h1>
      <%%= link_to <%= new_helper(type: :path) %>, class: "btn btn-primary" do %>
        <%%= i 'plus' %> New <%= human_name %>
      <%% end if Current.user.admin? %>
    </div>
    <div class="card-body">
      <%% if @<%= plural_table_name %>.any? %>
        <div class="row">
          <%% @<%= plural_table_name %>.each do |<%= singular_table_name %>| %>
            <div class="col-12 col-md-4 col-lg-3">
              <div class="card mb-2 text-bg-secondary">
                <div class="card-header">
                  <strong><%%= link_to <%= singular_table_name %>.<%= attributes.first.name %>, <%= singular_table_name %>, class: "text-reset text-decoration-none" %></strong>
                </div>
                <div class="card-body">
                  <dl class="mb-0">
<% attributes.reject(&:password_digest?).reject { |a| a.name == attributes.first.name || a.name.ends_with?("_id") }.each do |attribute| -%>
                    <dt class="small text-uppercase text-secondary-emphasis"><%= attribute.human_name %></dt>
                    <dd class="mb-0"><%%= <%= singular_table_name %>.<%= attribute.name %> %></dd>
<% end -%>
                  </dl>
                  <p class="small text-muted mt-2 mb-0">
                    <%%= i 'calendar' %> <%%= time_tag <%= singular_table_name %>.created_at, "data-bs-toggle": "tooltip", title: <%= singular_table_name %>.created_at.strftime("%B %d, %Y at %I:%M %p") do %>
                      <%%= time_ago_in_words <%= singular_table_name %>.created_at %> ago
                    <%% end %>
                  </p>
                </div>
                <div class="card-footer p-1 d-flex justify-content-end gap-1">
                  <%%= link_to edit_<%= singular_table_name %>_path(<%= singular_table_name %>), class: "btn btn-sm btn-warning" do %>
                    <%%= i 'pencil' %>
                  <%% end if Current.user.admin? %>
                  <%%= button_to <%= singular_table_name %>, method: :delete, class: "btn btn-sm btn-danger" do %>
                    <%%= i 'trash' %>
                  <%% end if Current.user.admin? %>
                </div>
              </div>
            </div>
          <%% end %>
        </div>
      <%% else %>
        <p class="text-muted mb-0"><%%= i 'ban' %> No <%= plural_table_name %> yet.</p>
      <%% end %>
    </div>
  </div>
</div>
