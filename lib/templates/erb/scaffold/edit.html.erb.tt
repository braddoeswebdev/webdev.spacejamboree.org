<%% content_for :title, "Editing <%= human_name.downcase %>" %>

<div class="container">
  <div class="card">
    <div class="card-header">
      <h1 class="mb-0"><%%= i 'pencil' %> Editing <%= human_name %></h1>
    </div>
    <div class="card-body">
      <%%= render "form", <%= singular_table_name %>: @<%= singular_table_name %> %>
    </div>
    <div class="card-footer">
      <%%= link_to @<%= singular_table_name %>, class: "btn btn-dark" do %>
        <%%= i 'arrow-left' %> Back to <%= human_name.downcase %>
      <%% end %>
    </div>
  </div>
</div>
